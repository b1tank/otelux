{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "desktop: build",
			"type": "shell",
			"command": "npm run build -w @otelux/desktop",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"presentation": {
				"reveal": "silent",
				"panel": "shared",
				"clear": true
			},
			"problemMatcher": []
		},
		{
			"label": "desktop: dev (with --inspect)",
			"type": "shell",
			"command": "npm run -w @otelux/desktop dev -- --inspect=9229",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"isBackground": true,
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"problemMatcher": []
		}
	]
}
