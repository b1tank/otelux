{
	"name": "@otelux/desktop",
	"version": "0.1.2",
	"private": true,
	"description": "OTelux desktop app — Electron shell hosting the receiver and the React workbench.",
	"author": "OTelux contributors",
	"homepage": "https://github.com/b1tank/otelux",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/b1tank/otelux.git"
	},
	"desktopName": "com.otelux.desktop",
	"type": "module",
	"main": "out/main/index.js",
	"scripts": {
		"dev": "electron-vite dev",
		"build": "electron-vite build && node scripts/verify-preload.mjs",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
		"test": "vitest run --passWithNoTests",
		"clean": "rm -rf out release .turbo",
		"start": "electron-vite preview",
		"generate:notices": "node scripts/generate-notices.mjs",
		"package": "npm run generate:notices && npm run build && electron-builder --linux --publish=never",
		"package:dir": "npm run generate:notices && npm run build && electron-builder --linux dir",
		"smoke": "node scripts/smoke.mjs"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"dependencies": {
		"@otelux/local-runtime": "*",
		"@otelux/protocol": "*",
		"@otelux/types": "*",
		"@otelux/ui": "*",
		"react": "18.3.1",
		"react-dom": "18.3.1"
	},
	"devDependencies": {
		"@types/node": "22.20.1",
		"@types/react": "18.3.12",
		"@types/react-dom": "18.3.1",
		"@vitejs/plugin-react": "5.2.0",
		"electron": "43.1.0",
		"electron-builder": "26.15.3",
		"electron-vite": "5.0.0",
		"typescript": "5.7.2",
		"vite": "7.3.6",
		"vitest": "4.1.10"
	}
}
