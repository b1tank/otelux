{
	"name": "@otelux/desktop",
	"version": "0.0.0",
	"private": true,
	"description": "OTelux desktop app — Electron shell hosting the receiver and the React workbench.",
	"license": "MIT",
	"type": "module",
	"main": "out/main/index.js",
	"scripts": {
		"dev": "electron-vite dev",
		"build": "electron-vite build",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
		"test": "vitest run --passWithNoTests",
		"clean": "rm -rf out release .turbo",
		"start": "electron-vite preview",
		"package": "electron-vite build && electron-builder --linux --publish=never"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"dependencies": {
		"@otelux/adapter-direct": "*",
		"@otelux/engine": "*",
		"@otelux/engine-node": "*",
		"@otelux/protocol": "*",
		"@otelux/receiver": "*",
		"@otelux/types": "*",
		"@otelux/ui": "*",
		"react": "18.3.1",
		"react-dom": "18.3.1"
	},
	"devDependencies": {
		"@types/node": "22.10.1",
		"@types/react": "18.3.12",
		"@types/react-dom": "18.3.1",
		"@vitejs/plugin-react": "4.3.4",
		"electron": "33.2.1",
		"electron-builder": "25.1.8",
		"electron-vite": "2.3.0",
		"typescript": "5.7.2",
		"vite": "5.4.11",
		"vitest": "2.1.8"
	}
}
