{
	"name": "@otelux/cli",
	"version": "0.1.12",
	"private": true,
	"description": "Thin lifecycle and diagnostics client for the local OTelux runtime.",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": ["dist", "README.md"],
	"bin": {
		"oteluxctl": "./dist/index.js"
	},
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit",
		"test": "npm run build && node --test scripts/*.node-test.mjs",
		"clean": "rm -rf dist .turbo"
	},
	"dependencies": {
		"@otelux/agent-integrations": "*",
		"@otelux/local-runtime": "*"
	},
	"devDependencies": {
		"@types/node": "22.20.1",
		"tsup": "8.5.1",
		"typescript": "5.7.2"
	}
}
