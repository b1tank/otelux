{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://otelux.dev/schema/v1/result-settings.schema.json",
  "title": "runtime/getSettings result",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "otlp": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "required": [
        "port"
      ],
      "additionalProperties": false
    },
    "mcp": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "required": [
        "enabled",
        "port"
      ],
      "additionalProperties": false
    },
    "retention": {
      "type": "object",
      "properties": {
        "maxAgeHours": {
          "type": "integer",
          "minimum": 0,
          "maximum": 43800
        },
        "maxSizeMb": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        }
      },
      "required": [
        "maxAgeHours",
        "maxSizeMb"
      ],
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "properties": {
        "dbPath": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "required": [
        "dbPath"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "revision",
    "otlp",
    "mcp",
    "retention",
    "storage"
  ],
  "additionalProperties": false
}
