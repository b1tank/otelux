{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://otelux.dev/schema/v1/result-storage-usage.schema.json",
  "title": "runtime/getStorageUsage result",
  "type": "object",
  "properties": {
    "activePath": {
      "type": "string",
      "maxLength": 4096
    },
    "retentionBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "databaseFileBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "walBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sharedMemoryBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "totalBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "activePath",
    "retentionBytes",
    "databaseFileBytes",
    "walBytes",
    "sharedMemoryBytes",
    "totalBytes"
  ],
  "additionalProperties": false
}
