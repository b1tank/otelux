{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://otelux.dev/schema/v1/result-list-traces.schema.json",
  "title": "telemetry/listTraces result",
  "type": "object",
  "properties": {
    "rows": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "traceId": {
            "type": "string",
            "maxLength": 32,
            "pattern": "^[0-9a-f]{32}$"
          },
          "rootName": {
            "type": "string",
            "maxLength": 2048
          },
          "startTimeUnixNano": {
            "$ref": "https://otelux.dev/schema/v1/tagged-bigint.schema.json"
          },
          "durationNanos": {
            "$ref": "https://otelux.dev/schema/v1/tagged-bigint.schema.json"
          },
          "services": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "type": "string",
              "maxLength": 2048
            }
          },
          "spanCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "errorCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "traceId",
          "rootName",
          "startTimeUnixNano",
          "durationNanos",
          "services",
          "spanCount",
          "errorCount"
        ],
        "additionalProperties": false
      }
    },
    "totalCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "totalCountIsExact": {
      "type": "boolean"
    },
    "nextCursor": {
      "type": "string",
      "maxLength": 512
    }
  },
  "required": [
    "rows",
    "totalCount"
  ],
  "additionalProperties": false
}
