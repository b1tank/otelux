{
	"name": "@otelux/protocol",
	"version": "0.0.0",
	"private": true,
	"description": "Browser-safe query and runtime control contracts for OTelux clients.",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": ["dist", "schema", "README.md"],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run && npm run schema:check",
		"schema:generate": "node scripts/schema-snapshots.mjs",
		"schema:check": "node scripts/schema-snapshots.mjs --check",
		"clean": "rm -rf dist .turbo"
	},
	"dependencies": {
		"@otelux/types": "*"
	},
	"devDependencies": {
		"@types/node": "22.20.1",
		"tsup": "8.5.1",
		"typescript": "5.9.3",
		"vitest": "4.1.11"
	}
}
