{
	"name": "@otelux/local-runtime",
	"version": "0.0.0",
	"private": true,
	"description": "Single-process local OTelux runtime for storage, OTLP ingest, MCP, and client queries.",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"oteluxd": "./dist/daemon.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": ["dist", "README.md"],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run && npm run build && node --test scripts/*.node-test.mjs",
		"clean": "rm -rf dist .turbo"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"dependencies": {
		"@hono/node-server": "2.0.12",
		"@otelux/adapter-http": "*",
		"@otelux/engine": "*",
		"@otelux/engine-node": "*",
		"@otelux/mcp-server": "*",
		"@otelux/protocol": "*",
		"@otelux/receiver": "*",
		"@otelux/types": "*"
	},
	"devDependencies": {
		"@types/node": "22.20.1",
		"tsup": "8.5.1",
		"typescript": "5.9.3",
		"vitest": "4.1.11"
	}
}
