{
	"name": "@otelux/ui",
	"version": "0.0.0",
	"private": true,
	"description": "React components for the OTelux viewer.",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./workbench.css": "./dist/workbench.css"
	},
	"files": ["dist", "README.md"],
	"sideEffects": ["**/*.css"],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"clean": "rm -rf dist .turbo"
	},
	"peerDependencies": {
		"react": "^18.0.0",
		"react-dom": "^18.0.0"
	},
	"dependencies": {
		"@otelux/engine": "*",
		"@otelux/protocol": "*",
		"@otelux/types": "*"
	},
	"devDependencies": {
		"@testing-library/react": "16.3.3",
		"@types/react": "18.3.12",
		"@types/react-dom": "18.3.1",
		"jsdom": "28.1.0",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"tsup": "8.5.1",
		"typescript": "5.9.3",
		"vitest": "4.1.11"
	}
}
