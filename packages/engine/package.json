{
	"name": "@otelux/engine",
	"version": "0.0.0",
	"private": true,
	"description": "Pure-TS OpenTelemetry engine — ingest, query, layout, live subscription. Pluggable storage.",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": ["dist", "README.md"],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"clean": "rm -rf dist .turbo"
	},
	"dependencies": {
		"@otelux/protocol": "*",
		"@otelux/types": "*"
	},
	"devDependencies": {
		"tsup": "8.5.1",
		"typescript": "5.9.3",
		"vitest": "4.1.11"
	}
}
